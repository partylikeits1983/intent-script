# Copy to `.env` and fill in. `.env` is git-ignored.
# Both the `make advisor` target and the advisor binary (`dotenvy::dotenv()`)
# pick this up automatically when invoked from the intent-script repo root.

# Required for `cargo run ... --bin advisor` — the OpenAI key used by Rig.
# Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-proj-...

# Optional — default OpenAI model for the advisor. Overridden by `--model`.
# Examples: gpt-4o, gpt-4o-mini, gpt-5-nano, o4-mini.
ADVISOR_MODEL=gpt-4o

# Optional — override the built-in pricing table for cost estimation. Useful
# for models the table doesn't know (e.g. gpt-5-nano) or to plug in fresh
# pricing without rebuilding. USD per 1M tokens.
# ADVISOR_PRICE_INPUT=2.50
# ADVISOR_PRICE_OUTPUT=10.00
# ADVISOR_PRICE_CACHED_INPUT=1.25   # optional; defaults to INPUT × 0.5

# Optional — RPC URL used by `make test-anvil` / `make test-fork-*` and by
# `advisor --simulate --rpc $ETH_RPC_URL`. Defaults to a public node in the
# makefile if unset.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
